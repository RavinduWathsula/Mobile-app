generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// 1. USERS & AUTH
// ═══════════════════════════════════════════════

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(200)
  email        String    @unique @db.VarChar(200)
  username     String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  phone        String?   @db.VarChar(30)
  department   Department @default(FrontOffice)
  roleId       Int       @map("role_id")
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  status       UserStatus @default(pending)
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role               Role               @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  createdBookings    Booking[]          @relation("BookingCreator")
  housekeepingTasks  HousekeepingTask[] @relation("TaskAssignee")
  createdOrders      RestaurantOrder[]  @relation("OrderCreator")
  createdEvents      EventReservation[] @relation("EventCreator")
  createdInvoices    Invoice[]          @relation("InvoiceCreator")
  receivedPayments   Payment[]          @relation("PaymentReceiver")
  auditLogs          AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum Department {
  FrontOffice  @map("Front Office")
  RestaurantPOS @map("Restaurant POS")
  Housekeeping
  BackOffice   @map("Back Office")
  Manager
  Admin
}

enum UserStatus {
  active
  inactive
  pending
}

// ═══════════════════════════════════════════════
// 2. ROOM MANAGEMENT
// ═══════════════════════════════════════════════

model RoomType {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(100)
  description  String?  @db.Text
  basePrice    Decimal  @map("base_price") @db.Decimal(12, 2)
  maxOccupancy Int      @default(2) @map("max_occupancy")
  totalRooms   Int      @default(0) @map("total_rooms")
  amenities    Json?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  rooms     Room[]
  ratePlans RatePlan[]
  bookings  Booking[]

  @@map("room_types")
}

model Room {
  id         Int        @id @default(autoincrement())
  roomNumber String     @unique @map("room_number") @db.VarChar(20)
  roomTypeId Int        @map("room_type_id")
  floor      Int        @default(1)
  status     RoomStatus @default(available)
  features   Json?
  notes      String?    @db.Text
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  bookings          Booking[]
  housekeepingTasks HousekeepingTask[]
  restaurantOrders  RestaurantOrder[]

  @@map("rooms")
}

model RatePlan {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(200)
  description String? @db.Text
  roomTypeId Int      @map("room_type_id")
  mealPlan   MealPlanType @default(room_only) @map("meal_plan")
  rate       Decimal  @db.Decimal(12, 2)
  season     String   @default("All Year") @db.VarChar(50)
  validFrom  DateTime? @map("valid_from")
  validTo    DateTime? @map("valid_to")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id])

  @@map("rate_plans")
}

enum RoomStatus {
  available
  occupied
  dirty
  maintenance
  out_of_order
}

enum MealPlanType {
  room_only  @map("room-only")
  bnb
  half_board @map("half-board")
  full_board @map("full-board")
}

// ═══════════════════════════════════════════════
// 3. MEAL PLANS
// ═══════════════════════════════════════════════

model MealPlan {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(200)
  mealType    MealCategory @map("meal_type")
  price       Decimal      @db.Decimal(12, 2)
  description String?      @db.Text
  menuItems   Json?        @map("menu_items")
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  bookingMeals BookingMeal[]

  @@map("meal_plans")
}

enum MealCategory {
  breakfast
  lunch
  dinner
  dessert
  event_package @map("event-package")
}

// ═══════════════════════════════════════════════
// 4. GUESTS
// ═══════════════════════════════════════════════

model Guest {
  id          Int      @id @default(autoincrement())
  firstName   String   @map("first_name") @db.VarChar(100)
  lastName    String   @map("last_name") @db.VarChar(100)
  email       String?  @db.VarChar(200)
  phone       String?  @db.VarChar(30)
  nationality String?  @db.VarChar(5)
  idType      IdType?  @default(nic) @map("id_type")
  idNumber    String?  @map("id_number") @db.VarChar(50)
  address     String?  @db.Text
  notes       String?  @db.Text
  totalStays  Int      @default(0) @map("total_stays")
  totalSpent  Decimal  @default(0) @map("total_spent") @db.Decimal(14, 2)
  vipStatus   Boolean  @default(false) @map("vip_status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bookings          Booking[]
  reservationGroups ReservationGroup[]
  restaurantOrders  RestaurantOrder[]
  invoices          Invoice[]
  dayOutBookings    DayOutBooking[]

  @@index([lastName, firstName])
  @@index([email])
  @@map("guests")
}

enum IdType {
  nic
  passport
  driving_license
}

// ═══════════════════════════════════════════════
// 5. BOOKINGS
// ═══════════════════════════════════════════════

model Booking {
  id                Int                @id @default(autoincrement())
  bookingRef        String             @unique @map("booking_ref") @db.VarChar(20)
  guestId           Int                @map("guest_id")
  groupId           Int?               @map("group_id")
  roomId            Int?               @map("room_id")
  roomTypeId        Int                @map("room_type_id")
  checkIn           DateTime           @map("check_in") @db.Date
  checkOut          DateTime           @map("check_out") @db.Date
  nights            Int
  adults            Int                @default(1)
  children          Int                @default(0)
  mealPlan          MealPlanType       @default(room_only) @map("meal_plan")
  roomRate          Decimal            @map("room_rate") @db.Decimal(12, 2)
  mealSurcharge     Decimal            @default(0) @map("meal_surcharge") @db.Decimal(12, 2)
  subtotal          Decimal            @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal            @default(0) @map("tax_amount") @db.Decimal(14, 2)
  serviceCharge     Decimal            @default(0) @map("service_charge") @db.Decimal(14, 2)
  totalAmount       Decimal            @default(0) @map("total_amount") @db.Decimal(14, 2)
  advancePaid       Decimal            @default(0) @map("advance_paid") @db.Decimal(14, 2)
  balanceDue        Decimal            @default(0) @map("balance_due") @db.Decimal(14, 2)
  status            BookingStatus      @default(confirmed)
  source            BookingSource      @default(direct)
  specialRequests   String?            @map("special_requests") @db.Text
  notes             String?            @db.Text
  createdBy         Int?               @map("created_by")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  guest             Guest              @relation(fields: [guestId], references: [id])
  reservationGroup  ReservationGroup?  @relation(fields: [groupId], references: [id])
  room              Room?              @relation(fields: [roomId], references: [id])
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id])
  creator           User?              @relation("BookingCreator", fields: [createdBy], references: [id])
  bookingMeals      BookingMeal[]
  orders            RestaurantOrder[]
  invoices          Invoice[]

  @@index([checkIn, checkOut])
  @@index([groupId])
  @@index([status])
  @@map("bookings")
}

model ReservationGroup {
  id         Int      @id @default(autoincrement())
  groupRef   String   @unique @map("group_ref") @db.VarChar(20)
  guestId    Int      @map("guest_id")
  notes      String?  @db.Text
  createdBy  Int?     @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  guest     Guest     @relation(fields: [guestId], references: [id])
  bookings  Booking[]

  @@index([guestId])
  @@map("reservation_groups")
}

model BookingMeal {
  id         Int      @id @default(autoincrement())
  bookingId  Int      @map("booking_id")
  mealPlanId Int      @map("meal_plan_id")
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(12, 2)
  mealDate   DateTime? @map("meal_date") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mealPlan MealPlan @relation(fields: [mealPlanId], references: [id])

  @@map("booking_meals")
}

enum BookingStatus {
  confirmed
  checked_in
  checked_out
  cancelled
  no_show
}

enum BookingSource {
  direct
  ota
  walk_in
  corporate
  phone
  website
}

// ═══════════════════════════════════════════════
// 6. HOUSEKEEPING
// ═══════════════════════════════════════════════

model HousekeepingTask {
  id            Int             @id @default(autoincrement())
  roomId        Int             @map("room_id")
  taskType      HKTaskType      @default(cleaning) @map("task_type")
  priority      HKPriority      @default(medium)
  status        HKStatus        @default(pending)
  assignedTo    Int?            @map("assigned_to")
  notes         String?         @db.Text
  scheduledDate DateTime        @map("scheduled_date") @db.Date
  startedAt     DateTime?       @map("started_at")
  completedAt   DateTime?       @map("completed_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  room     Room  @relation(fields: [roomId], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assignedTo], references: [id])

  @@index([scheduledDate])
  @@index([status])
  @@map("housekeeping_tasks")
}

enum HKTaskType {
  cleaning
  deep_clean
  turndown
  inspection
  maintenance
  laundry
}

enum HKPriority {
  low
  medium
  high
  urgent
}

enum HKStatus {
  pending
  in_progress
  completed
  skipped
}

// ═══════════════════════════════════════════════
// 7. RESTAURANT POS
// ═══════════════════════════════════════════════

model MenuCategory {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items MenuItem[]

  @@map("menu_categories")
}

model MenuItem {
  id              Int      @id @default(autoincrement())
  categoryId      Int      @map("category_id")
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  price           Decimal  @db.Decimal(12, 2)
  imageUrl        String?  @map("image_url") @db.VarChar(500)
  preparationTime Int      @default(15) @map("preparation_time")
  isVegetarian    Boolean  @default(false) @map("is_vegetarian")
  isSpicy         Boolean  @default(false) @map("is_spicy")
  isAvailable     Boolean  @default(true) @map("is_available")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category   MenuCategory @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@map("menu_items")
}

model RestaurantOrder {
  id            Int          @id @default(autoincrement())
  orderNumber   String       @unique @map("order_number") @db.VarChar(20)
  orderType     OrderType    @default(dine_in) @map("order_type")
  tableNumber   String?      @map("table_number") @db.VarChar(10)
  roomId        Int?         @map("room_id")
  guestId       Int?         @map("guest_id")
  bookingId     Int?         @map("booking_id")
  status        OrderStatus  @default(pending)
  subtotal      Decimal      @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal      @default(0) @map("tax_amount") @db.Decimal(14, 2)
  serviceCharge Decimal      @default(0) @map("service_charge") @db.Decimal(14, 2)
  discount      Decimal      @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal      @default(0) @map("total_amount") @db.Decimal(14, 2)
  paymentMethod PaymentMethodType? @map("payment_method")
  paymentStatus PaymentStatusType @default(unpaid) @map("payment_status")
  notes         String?      @db.Text
  createdBy     Int?         @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  room     Room?    @relation(fields: [roomId], references: [id])
  guest    Guest?   @relation(fields: [guestId], references: [id])
  booking  Booking? @relation(fields: [bookingId], references: [id])
  creator  User?    @relation("OrderCreator", fields: [createdBy], references: [id])
  items    OrderItem[]
  invoices Invoice[]

  @@index([status])
  @@index([createdAt])
  @@map("restaurant_orders")
}

model OrderItem {
  id                  Int             @id @default(autoincrement())
  orderId             Int             @map("order_id")
  menuItemId          Int             @map("menu_item_id")
  quantity            Int             @default(1)
  unitPrice           Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice          Decimal         @map("total_price") @db.Decimal(12, 2)
  specialInstructions String?         @map("special_instructions") @db.Text
  status              OrderItemStatus @default(pending)
  createdAt           DateTime        @default(now()) @map("created_at")

  order    RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])

  @@map("order_items")
}

enum OrderType {
  dine_in
  takeaway
  room_service
}

enum OrderStatus {
  pending
  preparing
  ready
  served
  completed
  cancelled
}

enum OrderItemStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum PaymentMethodType {
  cash
  card
  bank_transfer
  online
  room_charge
}

enum PaymentStatusType {
  unpaid
  partial
  paid
}

// ═══════════════════════════════════════════════
// 8. EVENTS & WEDDINGS
// ═══════════════════════════════════════════════

model EventVenue {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  description String?  @db.Text
  capacity    Int      @default(100)
  pricePerDay Decimal  @default(0) @map("price_per_day") @db.Decimal(12, 2)
  amenities   Json?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  reservations EventReservation[]

  @@map("event_venues")
}

model EventPackage {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(200)
  description    String?       @db.Text
  category       EventCategory
  pricePerPerson Decimal       @map("price_per_person") @db.Decimal(12, 2)
  minGuests      Int           @default(20) @map("min_guests")
  maxGuests      Int           @default(500) @map("max_guests")
  features       Json?
  foodOptions    Json?         @map("food_options")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  reservations EventReservation[]

  @@map("event_packages")
}

model EventReservation {
  id              Int          @id @default(autoincrement())
  reservationRef  String       @unique @map("reservation_ref") @db.VarChar(20)
  eventType       EventCategory @map("event_type")
  clientName      String       @map("client_name") @db.VarChar(200)
  clientEmail     String?      @map("client_email") @db.VarChar(200)
  clientPhone     String?      @map("client_phone") @db.VarChar(30)
  venueId         Int?         @map("venue_id")
  packageId       Int?         @map("package_id")
  eventDate       DateTime     @map("event_date") @db.Date
  eventTime       DateTime?    @map("event_time") @db.Time(0)
  endTime         DateTime?    @map("end_time") @db.Time(0)
  guestCount      Int          @default(50) @map("guest_count")
  setupStyle      String?      @map("setup_style") @db.VarChar(100)
  foodOptions     Json?        @map("food_options")
  decorationNotes String?      @map("decoration_notes") @db.Text
  subtotal        Decimal      @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal      @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount     Decimal      @default(0) @map("total_amount") @db.Decimal(14, 2)
  advancePaid     Decimal      @default(0) @map("advance_paid") @db.Decimal(14, 2)
  balanceDue      Decimal      @default(0) @map("balance_due") @db.Decimal(14, 2)
  status          EventStatus  @default(inquiry)
  notes           String?      @db.Text
  createdBy       Int?         @map("created_by")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  venue   EventVenue?   @relation(fields: [venueId], references: [id])
  package EventPackage? @relation(fields: [packageId], references: [id])
  creator User?         @relation("EventCreator", fields: [createdBy], references: [id])
  invoices Invoice[]

  @@index([eventDate])
  @@index([status])
  @@map("event_reservations")
}

enum EventCategory {
  wedding
  corporate
  birthday
  conference
  daytrip
  custom
}

enum EventStatus {
  inquiry
  confirmed
  in_progress
  completed
  cancelled
}

// ═══════════════════════════════════════════════
// 9. DAY OUT PLANS
// ═══════════════════════════════════════════════

model DayOutPlan {
  id              Int            @id @default(autoincrement())
  name            String         @db.VarChar(200)
  description     String?        @db.Text
  category        DayOutCategory
  pricePerPerson  Decimal        @map("price_per_person") @db.Decimal(12, 2)
  durationHours   Decimal        @default(8) @map("duration_hours") @db.Decimal(4, 1)
  maxParticipants Int            @default(20) @map("max_participants")
  inclusions      Json?
  itinerary       Json?
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  bookings DayOutBooking[]

  @@map("day_out_plans")
}

model DayOutBooking {
  id           Int              @id @default(autoincrement())
  bookingRef   String           @unique @map("booking_ref") @db.VarChar(20)
  planId       Int              @map("plan_id")
  guestId      Int?             @map("guest_id")
  clientName   String           @map("client_name") @db.VarChar(200)
  clientPhone  String?          @map("client_phone") @db.VarChar(30)
  tripDate     DateTime         @map("trip_date") @db.Date
  participants Int              @default(1)
  totalAmount  Decimal          @default(0) @map("total_amount") @db.Decimal(14, 2)
  status       DayOutStatus     @default(confirmed)
  notes        String?          @db.Text
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  plan  DayOutPlan @relation(fields: [planId], references: [id])
  guest Guest?     @relation(fields: [guestId], references: [id])

  @@map("day_out_bookings")
}

enum DayOutCategory {
  adventure
  nature
  cultural
  wellness
  family
  romantic
}

enum DayOutStatus {
  confirmed
  in_progress
  completed
  cancelled
}

// ═══════════════════════════════════════════════
// 10. BILLING
// ═══════════════════════════════════════════════

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(20)
  bookingId     Int?          @map("booking_id")
  orderId       Int?          @map("order_id")
  eventId       Int?          @map("event_id")
  guestId       Int?          @map("guest_id")
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(14, 2)
  serviceCharge Decimal       @default(0) @map("service_charge") @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  balanceDue    Decimal       @default(0) @map("balance_due") @db.Decimal(14, 2)
  status        InvoiceStatus @default(draft)
  dueDate       DateTime?     @map("due_date") @db.Date
  notes         String?       @db.Text
  createdBy     Int?          @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking  Booking?          @relation(fields: [bookingId], references: [id])
  order    RestaurantOrder?  @relation(fields: [orderId], references: [id])
  event    EventReservation? @relation(fields: [eventId], references: [id])
  guest    Guest?            @relation(fields: [guestId], references: [id])
  creator  User?             @relation("InvoiceCreator", fields: [createdBy], references: [id])
  payments Payment[]

  @@map("invoices")
}

model Payment {
  id            Int               @id @default(autoincrement())
  invoiceId     Int               @map("invoice_id")
  amount        Decimal           @db.Decimal(14, 2)
  paymentMethod PaymentMethodType @map("payment_method")
  referenceNo   String?           @map("reference_no") @db.VarChar(100)
  notes         String?           @db.Text
  receivedBy    Int?              @map("received_by")
  paymentDate   DateTime          @default(now()) @map("payment_date")
  createdAt     DateTime          @default(now()) @map("created_at")

  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  receiver User?   @relation("PaymentReceiver", fields: [receivedBy], references: [id])

  @@map("payments")
}

enum InvoiceStatus {
  draft
  issued
  paid
  partial
  overdue
  cancelled
}

// ═══════════════════════════════════════════════
// 11. AUDIT LOG
// ═══════════════════════════════════════════════

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}



